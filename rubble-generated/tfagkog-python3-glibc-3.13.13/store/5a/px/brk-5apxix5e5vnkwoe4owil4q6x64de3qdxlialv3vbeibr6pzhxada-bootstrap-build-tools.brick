{ "id": "5apxix5e5vnkwoe4owil4q6x64de3qdxlialv3vbeibr6pzhxada-bootstrap-build-tools"
, "name": "bootstrap-build-tools"
, "build_platform": "x86_64-linux"
, "rubble_home": "/var/lib/rubble"
, "opaque": true
, "inputs": [
    { "brick": "3ymsqx4irog2cwz3opdekqpw4otufpn5qdjdmbgzswfjrt23imbq-zstd"
    , "alias": "zstd"
    , "transitive": "true"
    }
  , { "brick": "wluwjucbrlkece4f3oq2qk6uxprq3t7h2ogids4ymiz4nsvjqmwa-xz"
    , "alias": "xz"
    , "transitive": "true"
    }
  , { "brick": "vjkfcfgkm77x6m2ulurl7euwz2rnspl5pijijlqq5wmu4fcyn6la-unzip"
    , "alias": "unzip"
    , "transitive": "true"
    }
  , { "brick": "cca6hpdxtvtjn3hkbljrizdlu2cpldgeodds67hxlcf2nhclfc5a-m4"
    , "alias": "m4"
    , "transitive": "true"
    }
  , { "brick": "b6du7m4wvh6hhvuzjxtbgjxv3kmgap4w2jh2mjw7ztfs2mbseida-gzip"
    , "alias": "gzip"
    , "transitive": "true"
    }
  , { "brick": "xpq3y53udiwojwu3cmwsgbqn7pkk6y74expqaf4ss6goibdgypuq-grep"
    , "alias": "grep"
    , "transitive": "true"
    }
  , { "brick": "toyyhmevribb7khuvecg75ctwezy43ob5us3fe232gwncayr5hkq-gpatch"
    , "alias": "gpatch"
    , "transitive": "true"
    }
  , { "brick": "6itbkpqgk46i34vxf2bxe2jjugitys6463c73qfk5fhiipwku4ha-gnu-sed"
    , "alias": "gnu_sed"
    , "transitive": "true"
    }
  , { "brick": "cdgy6susoq245z4mch7qbgfzwfyqzywqchtfoveem66yiwhb4qba-gnu-make"
    , "alias": "gnu_make"
    , "transitive": "true"
    }
  , { "brick": "pw37lfr3ixpwcll66ytcwfkezsbh2smxf77zdjlx6ox6vwlifwxa-gawk"
    , "alias": "gawk"
    , "transitive": "true"
    }
  , { "brick": "26tn2yq4ryvlust5j46r2gfdg7ew7zg7gpth4bowtw5vxvj5xeiq-findutils"
    , "alias": "findutils"
    , "transitive": "true"
    }
  , { "brick": "vvyhmuysr2vjsftzfyed3zekunsonl6t34mrh55zkb3mmepagjsa-diffutils"
    , "alias": "diffutils"
    , "transitive": "true"
    }
  , { "brick": "itxgxgppoxlnoqfhav4tgvdmsqhkb6xraelfh5my4ex6t6asd6jq-bzip2"
    , "alias": "bzip2"
    , "transitive": "true"
    }
  , { "brick": "bxchorbehgapcopsqwo7w5zwjgenujywlkkytlnad3dvy5hpqc5q-bash"
    , "alias": "bash"
    , "transitive": "true"
    }
  , { "brick": "x63s7v4qom7r4x7j6vg6y7p2sofdrxxj3dgw7fqdqftwwhjpixaq-perl"
    , "alias": "perl"
    , "transitive": "true"
    }
  , { "brick": "btu4wdeflhf6iv4rk4awpoj4h3ke6bdsgsdmdj6icerqhprab2zq-bison"
    , "alias": "bison"
    , "transitive": "true"
    }
  , { "brick": "6fyi5giuhq2rktxlfg2epgwit5rqik345vr2o25yognyocmskspq-gnu-tar"
    , "alias": "gnu_tar"
    , "transitive": "true"
    }
  , { "brick": "ppdghkityovkxogtghygvs2mls7qza646xifdh4qt3pdr7enpi2a-coreutils"
    , "alias": "coreutils"
    , "transitive": "true"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "mkdir -p \"$out/bin\"\n"
        , "\n"
        , "create_wrapper() {\n"
        , "  wrapper_name=$1\n"
        , "  actual_binary=$2\n"
        , "  env_setup=${3:-}\n"
        , "  wrapper_path=\"$out/bin/$wrapper_name\"\n"
        , "\n"
        , "  cat > \"$wrapper_path\" <<EOF\n"
        , "#!$bash/bin/bash\n"
        , "${env_setup}\n"
        , "exec \"$actual_binary\" \"\\$@\"\n"
        , "EOF\n"
        , "  chmod +x \"$wrapper_path\"\n"
        , "  echo \"Created wrapper: $wrapper_name -> $actual_binary\"\n"
        , "}\n"
        , "\n"
        , "create_wrapper \"bash\" \"$bash/bin/bash\"\n"
        , "create_wrapper \"sh\" \"$bash/bin/bash\"\n"
        , "\n"
        , "for cmd in \\\n"
        , "  basename cat chgrp chmod chown chroot cksum comm cp csplit cut date dd df \\\n"
        , "  dir dircolors dirname du echo env expand expr factor false fmt fold \\\n"
        , "  head hostid id install join kill link ln logname ls md5sum mkdir mkfifo \\\n"
        , "  mknod mktemp mv nice nl nohup nproc numfmt od paste pathchk pinky pr \\\n"
        , "  printenv printf ptx pwd readlink realpath rm rmdir runcon seq sha1sum \\\n"
        , "  sha224sum sha256sum sha384sum sha512sum shred shuf sleep sort split stat \\\n"
        , "  stdbuf stty sum sync tac tail tee test timeout touch tr true truncate \\\n"
        , "  tsort tty uname unexpand uniq unlink uptime users vdir wc who whoami yes \\\n"
        , "  b2sum base32 base64\n"
        , "do\n"
        , "  if [ -f \"$coreutils/bin/${cmd}\" ]; then\n"
        , "    create_wrapper \"$cmd\" \"$coreutils/bin/${cmd}\"\n"
        , "  fi\n"
        , "done\n"
        , "\n"
        , "create_wrapper \"tar\" \"$gnu_tar\"\n"
        , "create_wrapper \"gtar\" \"$gnu_tar\"\n"
        , "create_wrapper \"gzip\" \"$gzip\"\n"
        , "create_wrapper \"gunzip\" \"$gzip\"\n"
        , "create_wrapper \"zcat\" \"$gzip\"\n"
        , "create_wrapper \"xz\" \"$xz\"\n"
        , "for cmd in xzcat unxz lzma lzmadec lzcat; do\n"
        , "  create_wrapper \"$cmd\" \"$xz\"\n"
        , "done\n"
        , "create_wrapper \"zstd\" \"$zstd\"\n"
        , "for cmd in zstdcat unzstd zstdmt; do\n"
        , "  create_wrapper \"$cmd\" \"$zstd\"\n"
        , "done\n"
        , "create_wrapper \"sed\" \"$gnu_sed\"\n"
        , "create_wrapper \"grep\" \"$grep\"\n"
        , "create_wrapper \"egrep\" \"$grep\"\n"
        , "create_wrapper \"fgrep\" \"$grep\"\n"
        , "create_wrapper \"make\" \"$gnu_make\"\n"
        , "create_wrapper \"gmake\" \"$gnu_make\"\n"
        , "create_wrapper \"patch\" \"$gpatch\"\n"
        , "create_wrapper \"gpatch\" \"$gpatch\"\n"
        , "\n"
        , "for cmd in find xargs; do\n"
        , "  if [ -f \"$findutils/bin/$cmd\" ]; then\n"
        , "    create_wrapper \"$cmd\" \"$findutils/bin/$cmd\"\n"
        , "  fi\n"
        , "done\n"
        , "\n"
        , "create_wrapper \"bzip2\" \"$bzip2\"\n"
        , "create_wrapper \"bunzip2\" \"$bzip2\"\n"
        , "create_wrapper \"bzcat\" \"$bzip2\"\n"
        , "create_wrapper \"unzip\" \"$unzip\"\n"
        , "\n"
        , "perl_env=\"export PERL5LIB=\\\"$perl/share/perl5/core_perl:$perl/lib/perl5/core_perl\\${PERL5LIB:+:}\\${PERL5LIB:-}\\\"\"\n"
        , "create_wrapper \"perl\" \"$perl/bin/perl\" \"$perl_env\"\n"
        , "create_wrapper \"awk\" \"$gawk\"\n"
        , "create_wrapper \"gawk\" \"$gawk\"\n"
        , "\n"
        , "for cmd in diff cmp diff3 sdiff; do\n"
        , "  if [ -f \"$diffutils/bin/$cmd\" ]; then\n"
        , "    create_wrapper \"$cmd\" \"$diffutils/bin/$cmd\"\n"
        , "  fi\n"
        , "done\n"
        , "\n"
        , "create_wrapper \"m4\" \"$m4\"\n"
        , "bison_env=\"export BISON_PKGDATADIR=\\\"$bison/share/bison\\\"\n"
        , "export M4=\\\"$m4\\\"\"\n"
        , "create_wrapper \"bison\" \"$bison/bin/bison\" \"$bison_env\"\n"
        , "create_wrapper \"yacc\" \"$bison/bin/yacc\" \"$bison_env\"\n"
        , "\n"
        , "{\n"
        , "  echo \"# Bootstrap build tools setup script for Linux\"\n"
        , "  echo \"export PATH=\\\"$out/bin\\\"\"\n"
        , "  echo \"export SHELL=\\\"$out/bin/bash\\\"\"\n"
        , "  echo \"export CONFIG_SHELL=\\\"$out/bin/bash\\\"\"\n"
        , "  echo \"export PERL5LIB=\\\"$perl/share/perl5/core_perl:$perl/lib/perl5/core_perl\\${PERL5LIB:+:}\\${PERL5LIB:-}\\\"\"\n"
        , "  echo \"export BISON_PKGDATADIR=\\\"$bison/share/bison\\\"\"\n"
        , "  echo \"export M4=\\\"$m4\\\"\"\n"
        , "  echo \"hash -r 2>/dev/null || true\"\n"
        , "} > \"$out/setup-env.sh\"\n"
        , "chmod +x \"$out/setup-env.sh\"\n"
        , "\n"
        , "echo \"=== Bootstrap build tools created ===\"\n"
        , "echo \"Wrappers created in: $out/bin\"\n"
        , "echo \"Tool count: $(ls -1 \"$out/bin\" | wc -l)\"\n"
        , "\"$out/bin/bash\" --version | head -1 || true\n"
        , "\"$out/bin/tar\" --version | head -1 || true\n"
        , "\"$out/bin/make\" --version | head -1 || true\n"
        , "\"$out/bin/perl\" --version 2>&1 | head -2 | tail -1 || true\n"
        , "\n"
        , "for forbidden_tool in gcc g++ cc c++ cpp ld as ar ranlib readelf strip objdump objcopy nm; do\n"
        , "  if [ -e \"$out/bin/$forbidden_tool\" ]; then\n"
        , "    echo \"Unexpected compiler or binutils wrapper: $forbidden_tool\" >&2\n"
        , "    exit 1\n"
        , "  fi\n"
        , "done"
        ]
      , "format": "text"
      }
    }
  ]
