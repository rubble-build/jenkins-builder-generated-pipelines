{ "id": "c5mx6r24inu4xhdgcdtdjpfflxamue4idrmbz4koxqv6frtuwjwq-rust-std-1.94.0"
, "name": "rust-std-1.94.0"
, "platform": "x86_64-linux"
, "inputs": [
    { "brick": "4cogqtlsttdlle5wrsmcke3em5qvfcvvir54ov3ru3elpsfnh7ja-rust-std-1.94.0-x86_64-unknown-linux-gnu.tar.xz"
    , "alias": "src"
    , "transitive": "false"
    }
  ]
, "env": [
    { "name": "IMPURE_ENV"
    , "value": "all_proxy http_proxy https_proxy no_proxy" }
  ]
, "outputs": [
    { "name": "out" }
  ]
, "builder": [
    { "shell": {
        "value": [
          "target_triple=\"${src[name]#*${name}-}\"\n"
        , "target_triple=\"${target_triple%%.*}\"\n"
        , "tar --strip-components=1 -Jxvf \"$src\"\n"
        , "mkdir -p \"$out/lib/rustlib/${target_triple}\"\n"
        , "mv rust-std-${target_triple}/lib/rustlib/${target_triple}/lib \"$out/lib/rustlib/${target_triple}/lib\""
        ]
      , "format": "text"
      }
    }
  ]
, "inventory": {
    "4cogqtlsttdlle5wrsmcke3em5qvfcvvir54ov3ru3elpsfnh7ja-rust-std-1.94.0-x86_64-unknown-linux-gnu.tar.xz":
      { "id": "4cogqtlsttdlle5wrsmcke3em5qvfcvvir54ov3ru3elpsfnh7ja-rust-std-1.94.0-x86_64-unknown-linux-gnu.tar.xz"
      , "name": "rust-std-1.94.0-x86_64-unknown-linux-gnu.tar.xz"
      , "src": {
          "url": "https://static.rust-lang.org/dist/2026-03-05/rust-std-1.94.0-x86_64-unknown-linux-gnu.tar.xz"
        , "checksum": "sha256:dd33653107c36e040082050d9e547e64dac5b456ba74069430d838c00c189a05"
        }
      , "env": [
          { "name": "IMPURE_ENV"
          , "value": "all_proxy http_proxy https_proxy no_proxy" }
        ]
      , "var": [
          { "name": "__rubble_skip_src_split__"
          , "value": "true"
          }
        ]
      , "outputs": [
          { "name": "out" }
        ]
      , "builder": [
          { "shell": {
              "value": [
                "cp -ar \"$src\" \"$out\""
              ]
            , "format": "text"
            }
          }
        ]
      }
  }
}
