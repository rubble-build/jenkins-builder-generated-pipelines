      'brickFile': 'rubble-generated/j4l43hv-rubble/store/zw/da/brk-zwdawolcw4fqjnlmmwfrxjwrxcplq7t3jb73x5seskofbtj353na-libattr-2.5.2-r2.apk.brick',
      'buildAllowed': true,
      'bundleUrl': 'https://github.com/rubble-build/RubbleR-releases/releases/download/20260917225042-35282704594-1/x86_64-linux-2tlarnx-rubble.tar',
      'deps': [],
      'displayName': 'zwdawol-libattr-2.5.2-r2.apk-libattr-2.5.2-r2.apk',
      'executionOsFamily': 'unix',
      'importerUrl': 'https://github.com/rubble-build/RubbleR-releases/releases/download/20260914034639-34803620985-1/x86_64-linux-vyv4icp-rubble-inventory-bundle-import.sh',
      'isRoot': false,
